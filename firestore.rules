rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'shineonyou1274@gmail.com'
            || exists(/databases/$(db)/documents/admins/$(request.auth.token.email)));
    }
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'shineonyou1274@gmail.com'
            || (exists(/databases/$(db)/documents/admins/$(request.auth.token.email))
                && get(/databases/$(db)/documents/admins/$(request.auth.token.email)).data.get('role', 'staff') == 'owner'));
    }
    function S() { return get(/databases/$(db)/documents/settings/main).data; }
    function P(tok) { return /databases/$(db)/documents/participants/$(tok); }
    function C() { return /databases/$(db)/documents/counters/main; }
    function MK(m) { return /databases/$(db)/documents/marks/$(m); }
    function tokOf(m) { return getAfter(MK(m)).data.tok; }

    // ---------- marks: 공개 문서에 토큰 대신 남기는 일회용 표 (읽기는 운영진만) ----------
    match /marks/{m} {
      allow read: if isAdmin();
      allow create: if m.size() >= 16
        && request.resource.data.keys().hasOnly(['tok'])
        && request.resource.data.tok is string;
      allow update, delete: if isAdmin();
    }

    // ---------- settings / secrets / admins ----------
    match /settings/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /secrets/{id} {
      allow read, write: if isOwner();
    }
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // ---------- counter ----------
    function counterPlusOk(n, o) {
      let tk = tokOf(n.last);
      let t = getAfter(P(tk)).data.type;
      return n.total == o.total + 1
        && n.total <= S().capacity
        && !exists(P(tk))
        && existsAfter(P(tk))
        && n[t] == o[t] + 1
        && n.diff(o).affectedKeys().hasOnly(['total', t, 'last', 'seq'])
        // 접수번호: 정식 신청은 seq+1 = 그 사람 번호. 테스트(또는 번호 없이 들어온 예전 화면)는 seq 그대로
        && ((n.get('seq', -1) == o.get('seq', -1) + 1 && getAfter(P(tk)).data.get('no', -2) == n.get('seq', -1))
            || (n.get('seq', -1) == o.get('seq', -1) && !('no' in getAfter(P(tk)).data)));
    }
    function counterMinusOk(n, o) {
      let tk = tokOf(n.last);
      let t = get(P(tk)).data.type;
      return n.total == o.total - 1
        && get(P(tk)).data.status == 'active'
        && getAfter(P(tk)).data.status == 'cancelled'
        && n[t] == o[t] - 1
        && n.diff(o).affectedKeys().hasOnly(['total', t, 'last']);
    }
    match /counters/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (id == 'main'
            && request.resource.data.keys().hasOnly(['total', 'nanum', 'baeum', 'outside', 'last', 'seq'])
            && (counterPlusOk(request.resource.data, resource.data)
                || counterMinusOk(request.resource.data, resource.data)));
    }

    // ---------- participants ----------
    function testOk(d) {
      return d.get('test', false) == true
        && d.get('testKey', '') == get(/databases/$(db)/documents/secrets/test).data.code
        && (d.type != 'nanum' || d.code == get(/databases/$(db)/documents/secrets/nanum).data.code);
    }
    function staffOk(d) {
      return d.get('staff', false) == true
        && request.time < S().nanumStart
        && d.get('staffKey', '') == get(/databases/$(db)/documents/secrets/staff).data.code;
    }
    function typeTimeOk(d) {
      return testOk(d) || staffOk(d) || request.time < S().closeAt
        && ((d.type == 'nanum' && request.time >= S().nanumStart
              && d.code == get(/databases/$(db)/documents/secrets/nanum).data.code)
          || (d.type == 'baeum' && request.time >= S().baeumStart)
          || (d.type == 'outside' && request.time >= S().openStart));
    }
    function validCreate(tok) {
      let d = request.resource.data;
      return tok.size() >= 20
        && d.keys().hasOnly(['pno', 'name', 'school', 'phone', 'email', 'type', 'status',
                             'createdAt', 'consent', 'photoAck', 'code', 'phoneKey', 'lookupKey', 'test', 'testKey', 'staff', 'staffKey', 'no'])
        && (!('no' in d) || (d.no is int && d.get('test', false) != true))
        && d.status == 'active'
        && d.consent == true
        && d.createdAt == request.time
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.school is string && d.school.size() > 0 && d.school.size() <= 60
        && d.phone is string && d.phone.matches('^01[0-9]{8,9}$')
        && d.pno is string && d.pno.size() <= 12
        && (!('email' in d) || (d.email is string && d.email.size() <= 80))
        && d.phoneKey is string && d.lookupKey is string
        && typeTimeOk(d)
        && tokOf(getAfter(C()).data.last) == tok
        && getAfter(C()).data.total == get(C()).data.total + 1
        && existsAfter(/databases/$(db)/documents/phones/$(d.phoneKey))
        && existsAfter(/databases/$(db)/documents/lookups/$(d.lookupKey));
    }
    function validCancel(tok) {
      let d = request.resource.data;
      return resource.data.status == 'active'
        && d.status == 'cancelled'
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelPhone'])
        && d.cancelPhone == resource.data.phone
        && d.cancelledAt == request.time
        && request.time < S().cancelDeadline
        && tokOf(getAfter(C()).data.last) == tok
        && getAfter(C()).data.total == get(C()).data.total - 1
        && !existsAfter(/databases/$(db)/documents/phones/$(resource.data.phoneKey));
    }
    match /participants/{tok} {
      allow get: if true;            // 추측할 수 없는 토큰 = 개인 링크
      allow list: if isAdmin();
      allow create: if validCreate(tok);
      allow update: if isAdmin() || validCancel(tok);
      allow delete: if isOwner();
    }

    // ---------- 전화번호 중복 방지 (읽기 불가) ----------
    match /phones/{key} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['tok'])
        && !exists(P(request.resource.data.tok))
        && getAfter(P(request.resource.data.tok)).data.phoneKey == key;
      allow delete: if isAdmin()
        || getAfter(P(resource.data.tok)).data.status == 'cancelled';
      allow update: if isAdmin();
    }

    // ---------- 해커톤 ----------
    function H(t) { return /databases/$(db)/documents/hackers/$(t); }
    function T(c) { return /databases/$(db)/documents/teams/$(c); }
    function J(v) { return /databases/$(db)/documents/hjoins/$(v); }
    function HC() { return /databases/$(db)/documents/hcounters/main; }

    match /hcounters/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (id == 'main'
            && request.resource.data.keys().hasOnly(['total', 'last'])
            && ((request.resource.data.total == resource.data.total + 1
                  && request.resource.data.total <= S().hackCap
                  && !exists(H(tokOf(request.resource.data.last)))
                  && existsAfter(H(tokOf(request.resource.data.last))))
              || (request.resource.data.total == resource.data.total - 1
                  && get(H(tokOf(request.resource.data.last))).data.status == 'active'
                  && getAfter(H(tokOf(request.resource.data.last))).data.status == 'cancelled')));
    }

    function teamLinkOk(d, tok) {
      return d.team is string
        && !exists(J(d.v)) && existsAfter(J(d.v))
        && getAfter(J(d.v)).data.tok == tok
        && getAfter(J(d.v)).data.team == d.team
        && getAfter(T(d.team)).data.v == d.v;
    }
    function hackCreateOk(tok) {
      let d = request.resource.data;
      let p = get(P(tok)).data;
      return p.status == 'active'
        && (p.get('test', false) == true || p.get('staff', false) == true || (request.time >= S().hackOpen && request.time < S().hackClose))
        && d.keys().hasOnly(['name', 'pno', 'mode', 'team', 'topics', 'level', 'laptop', 'idea', 'status', 'createdAt', 'v'])
        && d.name == p.name && d.pno == p.pno
        && d.status == 'active' && d.createdAt == request.time && d.laptop == true
        && !exists(/databases/$(db)/documents/slots/$(tok + '_AM'))
        && !exists(/databases/$(db)/documents/slots/$(tok + '_PM1'))
        && d.mode in ['lead', 'join', 'match']
        && d.topics is list && d.topics.size() >= 1 && d.topics.size() <= 2
        && d.level in ['new', 'some', 'often']
        && (!('idea' in d) || (d.idea is string && d.idea.size() <= 100))
        && tokOf(getAfter(HC()).data.last) == tok
        && getAfter(HC()).data.total == get(HC()).data.total + 1
        && ((d.mode == 'match' && d.team == null) || (d.mode != 'match' && teamLinkOk(d, tok)));
    }
    function hackCancelOk(tok) {
      let d = request.resource.data;
      return resource.data.status == 'active' && d.status == 'cancelled'
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelPhone', 'v'])
        && d.cancelPhone == get(P(tok)).data.phone
        && d.cancelledAt == request.time
        && request.time < S().cancelDeadline
        && tokOf(getAfter(HC()).data.last) == tok
        && getAfter(HC()).data.total == get(HC()).data.total - 1
        && (resource.data.team == null
            || (getAfter(T(resource.data.team)).data.count == get(T(resource.data.team)).data.count - 1
                && getAfter(T(resource.data.team)).data.v == d.v));
    }
    match /hackers/{tok} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if hackCreateOk(tok);
      allow update: if isAdmin() || hackCancelOk(tok);
      allow delete: if isAdmin();
    }

    function joinOk(code, kind) {
      let v = request.resource.data.v;
      return !exists(J(v)) && existsAfter(J(v))
        && getAfter(J(v)).data.team == code
        && getAfter(J(v)).data.kind == kind;
    }
    function joinerName() {
      return get(P(getAfter(J(request.resource.data.v)).data.tok)).data.name;
    }
    match /teams/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (code.size() == 6
            && request.resource.data.keys().hasOnly(['name', 'count', 'names', 'v', 'createdAt'])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
            && request.resource.data.count == 1
            && joinOk(code, 'lead')
            && request.resource.data.names == [joinerName()]);
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'names', 'v'])
            && ((request.resource.data.count == resource.data.count + 1
                  && request.resource.data.count <= S().hackTeamMax
                  && joinOk(code, 'join')
                  && request.resource.data.names == resource.data.names.concat([joinerName()]))
              || (request.resource.data.count == resource.data.count - 1
                  && joinOk(code, 'leave')
                  && request.resource.data.names == resource.data.names.removeAll([joinerName()]))));
      allow delete: if isAdmin();
    }

    match /hjoins/{v} {
      allow read: if isAdmin();
      allow create: if v.size() >= 16
        && request.resource.data.keys().hasOnly(['tok', 'team', 'kind'])
        && getAfter(H(request.resource.data.tok)).data.v == v
        && ((request.resource.data.kind in ['lead', 'join']
              && !exists(H(request.resource.data.tok))
              && getAfter(H(request.resource.data.tok)).data.team == request.resource.data.team)
          || (request.resource.data.kind == 'leave'
              && get(H(request.resource.data.tok)).data.status == 'active'
              && get(H(request.resource.data.tok)).data.team == request.resource.data.team
              && getAfter(H(request.resource.data.tok)).data.status == 'cancelled'));
      allow update, delete: if isAdmin();
    }

    // ---------- 세션 좌석 + 대기 ----------
    // 확정 = seats 문서, 또는 대기표 번호(n)가 세션의 wh보다 작은 waits 문서 (대기에서 올라온 사람)
    function SE(sid) { return /databases/$(db)/documents/sessions/$(sid); }
    function SEAT(sid, tok) { return /databases/$(db)/documents/seats/$(sid + '__' + tok); }
    function WAIT(sid, tok) { return /databases/$(db)/documents/waits/$(sid + '__' + tok); }
    function WQ(sid, n) { return /databases/$(db)/documents/wq/$(sid + '_' + string(n)); }
    function SLOT(tok, k) { return /databases/$(db)/documents/slots/$(tok + '_' + k); }
    function hackBusy(tok) { return exists(H(tok)) && get(H(tok)).data.status == 'active'; }
    function opened(p) { return request.time >= S().nanumStart || p.get('test', false) == true; }
    function slotNew(tok, k, sid) { return !exists(SLOT(tok, k)) && getAfter(SLOT(tok, k)).data.sid == sid; }
    function slotsNew(tok, sl, sid) { return slotNew(tok, sl[0], sid) && (sl.size() < 2 || slotNew(tok, sl[1], sid)); }
    function slotsGone(tok, sl) { return !existsAfter(SLOT(tok, sl[0])) && (sl.size() < 2 || !existsAfter(SLOT(tok, sl[1]))); }
    function aliveAt(sid, i) {
      let t = get(WQ(sid, i)).data.tok;
      return exists(WAIT(sid, t)) && get(WAIT(sid, t)).data.n == i;
    }
    function deadAt(sid, i) {
      let t = get(WQ(sid, i)).data.tok;
      return !exists(WAIT(sid, t)) || get(WAIT(sid, t)).data.n != i;
    }
    function released(sid, t, o) {
      return (exists(SEAT(sid, t)) && !existsAfter(SEAT(sid, t)))
        || (!exists(SEAT(sid, t)) && exists(WAIT(sid, t))
            && get(WAIT(sid, t)).data.n < o.wh && !existsAfter(WAIT(sid, t)));
    }
    function sesOk(sid, n, o) {
      let ch = n.diff(o).affectedKeys();
      return ch.hasOnly(['count', 'last', 'wq', 'wh'])
        && (
          // A 빈자리에 앉기 (대기줄 없을 때만)
          (ch.hasOnly(['count', 'last']) && n.count == o.count + 1 && n.count <= o.cap && o.wh == o.wq
            && !exists(SEAT(sid, tokOf(n.last))) && existsAfter(SEAT(sid, tokOf(n.last))))
          // B 자리 놓기 (대기줄 없을 때)
          || (ch.hasOnly(['count', 'last']) && n.count == o.count - 1 && o.wh == o.wq
            && released(sid, tokOf(n.last), o))
          // C 자리 놓으면서 대기 1번을 확정으로 올리기
          || (ch.hasOnly(['wh', 'last']) && n.wh == o.wh + 1 && aliveAt(sid, o.wh)
            && released(sid, tokOf(n.last), o))
          // F 빈자리가 있으면 대기 1번 올리기 (정원 늘렸을 때 등)
          || (ch.hasOnly(['count', 'wh']) && n.count == o.count + 1 && n.count <= o.cap
            && n.wh == o.wh + 1 && aliveAt(sid, o.wh))
          // D 대기를 그만둔 번호 건너뛰기 (최대 3칸)
          || (ch.hasOnly(['wh']) && n.wh > o.wh && n.wh <= o.wq && n.wh <= o.wh + 3
            && deadAt(sid, o.wh)
            && (n.wh < o.wh + 2 || deadAt(sid, o.wh + 1))
            && (n.wh < o.wh + 3 || deadAt(sid, o.wh + 2)))
          // E 대기줄 서기
          || (ch.hasOnly(['wq']) && n.wq == o.wq + 1 && existsAfter(WQ(sid, o.wq)))
        );
    }
    function seatCreateOk(id) {
      let d = request.resource.data;
      let s = get(SE(d.sid)).data;
      let p = get(P(d.tok)).data;
      return d.keys().hasOnly(['sid', 'tok', 'at'])
        && id == d.sid + '__' + d.tok
        && d.at == request.time
        && p.status == 'active' && opened(p)
        && request.time < S().cancelDeadline
        && getAfter(SE(d.sid)).data.count == s.count + 1
        && tokOf(getAfter(SE(d.sid)).data.last) == d.tok
        && slotsNew(d.tok, s.slots, d.sid)
        && (!s.slots.hasAny(['AM', 'PM1']) || !hackBusy(d.tok));
    }
    function holderGoneOk(sid, tok) {
      let s = get(SE(sid)).data;
      let n = getAfter(SE(sid)).data;
      return request.time < S().cancelDeadline
        && tokOf(n.last) == tok
        && slotsGone(tok, s.slots)
        && (n.count == s.count - 1 || (n.count == s.count && n.wh == s.wh + 1));
    }
    function waitCreateOk(id) {
      let d = request.resource.data;
      let s = get(SE(d.sid)).data;
      let p = get(P(d.tok)).data;
      return d.keys().hasOnly(['sid', 'tok', 'n', 'at'])
        && id == d.sid + '__' + d.tok
        && d.at == request.time
        && p.status == 'active' && opened(p)
        && request.time < S().cancelDeadline
        && (s.count >= s.cap || s.wh < s.wq)
        && d.n == s.wq
        && getAfter(SE(d.sid)).data.wq == s.wq + 1
        && getAfter(WQ(d.sid, d.n)).data.tok == d.tok
        && !exists(SEAT(d.sid, d.tok))
        && slotsNew(d.tok, s.slots, d.sid)
        && (!s.slots.hasAny(['AM', 'PM1']) || !hackBusy(d.tok));
    }
    match /sessions/{sid} {
      allow read: if true;
      allow create, delete: if isOwner();
      allow update: if isAdmin() || sesOk(sid, request.resource.data, resource.data);
    }
    match /seats/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || seatCreateOk(id);
      allow delete: if isAdmin() || holderGoneOk(resource.data.sid, resource.data.tok);
    }
    match /waits/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || waitCreateOk(id);
      allow delete: if isAdmin()
        || (resource.data.n >= get(SE(resource.data.sid)).data.wh
            && slotsGone(resource.data.tok, get(SE(resource.data.sid)).data.slots))
        || (resource.data.n < get(SE(resource.data.sid)).data.wh
            && holderGoneOk(resource.data.sid, resource.data.tok));
    }
    match /wq/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['sid', 'n', 'tok'])
            && id == request.resource.data.sid + '_' + string(request.resource.data.n)
            && get(SE(request.resource.data.sid)).data.wq == request.resource.data.n
            && getAfter(WAIT(request.resource.data.sid, request.resource.data.tok)).data.n == request.resource.data.n);
      allow update, delete: if isAdmin();
    }
    match /slots/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow update: if isAdmin();
      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['sid', 'tok', 'k', 'w'])
            && id == request.resource.data.tok + '_' + request.resource.data.k
            && (request.resource.data.get('w', false) == true
                  ? existsAfter(WAIT(request.resource.data.sid, request.resource.data.tok))
                  : existsAfter(SEAT(request.resource.data.sid, request.resource.data.tok)))
            && get(SE(request.resource.data.sid)).data.slots.hasAny([request.resource.data.k]));
      allow delete: if isAdmin()
        || (resource.data.get('w', false) == true
              ? !existsAfter(WAIT(resource.data.sid, resource.data.tok))
              : !existsAfter(SEAT(resource.data.sid, resource.data.tok)));
    }

    // ---------- 도시락·자녀 동반·아이돌봄 ----------
    function EXD(t) { return /databases/$(db)/documents/extras/$(t); }
    function CC() { return /databases/$(db)/documents/ccounters/main; }
    function careCap() { return S().get('careCap', 20); }
    function extraBaseOk(d) {
      return d.keys().hasOnly(['lunch', 'kids', 'klunch', 'cc', 'cwn', 'at'])
        && d.lunch in ['galbi', 'chipotle', 'none']
        && d.kids is int && d.kids >= 0 && d.kids <= 10
        && d.get('klunch', 0) is int && d.get('klunch', 0) >= 0 && d.get('klunch', 0) <= d.kids
        && d.get('cc', 0) is int && d.get('cwn', 0) is int
        && d.get('cc', 0) >= 0 && d.get('cwn', 0) >= 0
        && (d.get('cc', 0) == 0 || d.get('cwn', 0) == 0)
        && d.get('cc', 0) + d.get('cwn', 0) <= d.kids
        && d.at == request.time
        && request.time < S().cancelDeadline;
    }
    // 돌봄 숫자가 바뀌면 같은 묶음에서 카운터도 이 토큰 표(mark)로 바뀌어야 함. 대기는 자리가 없을 때만
    function careChangeOk(tok, d, occ, ocw) {
      return (d.get('cc', 0) == occ && d.get('cwn', 0) == ocw)
        || (getAfter(CC()).data.last != get(CC()).data.last
            && tokOf(getAfter(CC()).data.last) == tok
            && (d.get('cwn', 0) == 0 || get(CC()).data.used - occ + d.get('cwn', 0) > careCap()));
    }
    match /extras/{tok} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (extraBaseOk(request.resource.data)
            && getAfter(P(tok)).data.status == 'active'
            && careChangeOk(tok, request.resource.data, 0, 0));
      allow update: if isAdmin()
        || (extraBaseOk(request.resource.data)
            && ((getAfter(P(tok)).data.status == 'active'
                  && careChangeOk(tok, request.resource.data, resource.data.get('cc', 0), resource.data.get('cwn', 0)))
              // 참가 취소하는 묶음에서는 돌봄을 0으로만 되돌릴 수 있음
              || (get(P(tok)).data.status == 'active'
                  && getAfter(P(tok)).data.status == 'cancelled'
                  && request.resource.data.get('cc', 0) == 0 && request.resource.data.get('cwn', 0) == 0
                  && careChangeOk(tok, request.resource.data, resource.data.get('cc', 0), resource.data.get('cwn', 0)))));
      allow delete: if isAdmin();
    }
    function careCounterOk(n, o) {
      let tk = tokOf(n.last);
      let e1 = getAfter(EXD(tk)).data;
      return !exists(MK(n.last)) && existsAfter(MK(n.last))
        && existsAfter(EXD(tk))
        && ((!exists(EXD(tk))
              && n.used == o.get('used', 0) + e1.get('cc', 0)
              && n.wait == o.get('wait', 0) + e1.get('cwn', 0))
          || (exists(EXD(tk))
              && n.used == o.get('used', 0) + e1.get('cc', 0) - get(EXD(tk)).data.get('cc', 0)
              && n.wait == o.get('wait', 0) + e1.get('cwn', 0) - get(EXD(tk)).data.get('cwn', 0)))
        && n.used >= 0 && n.wait >= 0
        && (n.used <= careCap() || n.used <= o.get('used', 0));
    }
    match /ccounters/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (id == 'main'
            && request.resource.data.keys().hasOnly(['used', 'wait', 'last'])
            && careCounterOk(request.resource.data, resource.data));
    }

    // ---------- 스탬프 ----------
    // 참가자마다 도장 코드 q (QR에는 토큰 대신 q만 넣음). qr/{q} → 토큰은 운영진만 읽음, qn/{q} → 이름·번호만 공개
    function QB(t) { return /databases/$(db)/documents/qrby/$(t); }
    function QR(q) { return /databases/$(db)/documents/qr/$(q); }
    match /qrby/{tok} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['q'])
            && request.resource.data.q is string && request.resource.data.q.size() == 8
            && get(P(tok)).data.status == 'active'
            && !exists(QR(request.resource.data.q))
            && getAfter(QR(request.resource.data.q)).data.tok == tok);
      allow update, delete: if isAdmin();
    }
    match /qr/{q} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['tok'])
            && !exists(QB(request.resource.data.tok))
            && getAfter(QB(request.resource.data.tok)).data.q == q);
      allow update, delete: if isAdmin();
    }
    match /qn/{q} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['name', 'no'])
            && !exists(QR(q)) && existsAfter(QR(q))
            && request.resource.data.name == get(P(getAfter(QR(q)).data.tok)).data.name
            && request.resource.data.no == get(P(getAfter(QR(q)).data.tok)).data.get('no', 0));
      allow update, delete: if isAdmin();
    }
    match /spots/{b} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /spotkeys/{b} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
    // 담당자 링크의 열쇠는 도장 문서에 남기지 않고, 같은 묶음에서 새로 만든 증명 문서로만 확인
    match /sproof/{p} {
      allow read: if isAdmin();
      allow create: if p.size() >= 16
        && request.resource.data.keys().hasOnly(['k', 'b'])
        && request.resource.data.k is string;
      allow update, delete: if isAdmin();
    }
    match /stamps/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['q', 'b', 'p', 'at'])
            && id == request.resource.data.q + '__' + request.resource.data.b
            && request.resource.data.at == request.time
            && exists(QR(request.resource.data.q))
            && get(P(get(QR(request.resource.data.q)).data.tok)).data.status == 'active'
            && get(/databases/$(db)/documents/spots/$(request.resource.data.b)).data.get('on', true) == true
            && !exists(/databases/$(db)/documents/sproof/$(request.resource.data.p))
            && getAfter(/databases/$(db)/documents/sproof/$(request.resource.data.p)).data.b == request.resource.data.b
            && getAfter(/databases/$(db)/documents/sproof/$(request.resource.data.p)).data.k == get(/databases/$(db)/documents/spotkeys/$(request.resource.data.b)).data.key);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- 참가자 알림 (공개 읽기, 운영진만 쓰기) ----------
    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- 출장 공문: 참가자는 need만, 발송 표시는 운영진만 ----------
    match /gm/{tok} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['need', 'at'])
            && request.resource.data.need is bool
            && request.resource.data.at == request.time
            && getAfter(P(tok)).data.status == 'active'
            && request.time < S().cancelDeadline);
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['need', 'at'])
            && request.resource.data.need is bool
            && request.resource.data.at == request.time
            && get(P(tok)).data.status == 'active'
            && request.time < S().cancelDeadline);
      allow delete: if isAdmin();
    }

    // ---------- 친구 초대: 신청할 때 초대한 사람의 접수번호만 (1회), 목록은 운영진만 ----------
    match /refs/{tok} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['by', 'at'])
            && request.resource.data.by is int
            && request.resource.data.by > 0 && request.resource.data.by < 10000
            && request.resource.data.at == request.time
            && getAfter(P(tok)).data.status == 'active'
            && getAfter(P(tok)).data.get('no', -1) != request.resource.data.by);
      allow update, delete: if isAdmin();
    }

    // ---------- 이름+전화로 내 여권 찾기 ----------
    match /lookups/{key} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['tok'])
        && !exists(P(request.resource.data.tok))
        && getAfter(P(request.resource.data.tok)).data.lookupKey == key;
      allow update: if isAdmin()
        || (request.resource.data.keys().hasOnly(['tok'])
            && get(P(resource.data.tok)).data.status == 'cancelled'
            && !exists(P(request.resource.data.tok))
            && getAfter(P(request.resource.data.tok)).data.lookupKey == key);
      allow delete: if isAdmin();
    }

    // ================= 마스코트 투표 (추가 전용 블록 · 초안 · 미배포) =================
    // 기존 함수(P, isAdmin, isOwner)만 재사용하고 기존 match/함수는 바꾸지 않는다.
    // 새 컬렉션: entries, votes, vstate, vreveal, vresults. 설정 문서: settings/vote (기존 settings 규칙: 누구나 읽기, owner 쓰기)
    // vstate/main = 투표 진행 상태 { phase: 'open'|'closed', epoch: 1부터, at }. settings는 owner가 아무 값이나 쓸 수 있으므로
    //   '마감·재개'는 이 문서의 정해진 전이로만 인정한다. 재개할 때마다 epoch가 1 오르고, 결과·공개 버튼은 epoch에 묶인다.
    //   => 재개하면 예전 결과·예전 공개 버튼은 자동으로 무효. 재마감 뒤에도 새로 집계하고 새로 눌러야 공개된다.
    // settings/vote 필드: open(bool), openAt/closeAt(timestamp, 사용자가 정함), allowTest(bool), staffTally(bool)
    //   (reveal 필드는 더 이상 쓰지 않는다: settings는 기존 규칙상 owner가 아무 값이나 쓸 수 있어서 공개 시점 통제에 못 씀)
    // 결과 공개 = vreveal/main 문서. 행사일(2026-12-19 00:00 KST) 이후에만 owner가 만들 수 있고, 그 전엔 무엇을 해도 비공개.
    // 이 투표는 비밀투표가 아니다: owner/운영진은 마감 뒤 votes 목록에서 탑승권별 선택을 볼 수 있다.
    function SV() { return /databases/$(db)/documents/settings/vote; }
    function VS() { return /databases/$(db)/documents/vstate/main; }
    function VR() { return /databases/$(db)/documents/vreveal/main; }
    function VPUB() { return /databases/$(db)/documents/vresults/public; }
    function MV() { return get(SV()).data; }
    function mvEpoch() { return get(VS()).data.epoch; }
    function mvPhaseOpen() { return exists(VS()) && get(VS()).data.phase == 'open'; }
    function mvTimesSet() {
      return MV().get('openAt', null) is timestamp && MV().get('closeAt', null) is timestamp;
    }
    function mvOpen() {
      return MV().get('open', false) == true && mvTimesSet()
        && request.time >= MV().openAt && request.time < MV().closeAt;
    }
    // 행사일 시작 = 2026-12-19 00:00 KST = 2026-12-18 15:00 UTC. 규칙 상수라 설정 문서 조작으로 못 바꾼다
    // (투표 기간이 아니다. 결과 공개가 가능해지는 가장 이른 시각일 뿐)
    function mvEventDay() { return timestamp.date(2026, 12, 18) + duration.value(15, 'h'); }
    function mvClosed() {
      return MV().get('closeAt', null) is timestamp && request.time >= MV().closeAt;
    }
    // 최종 마감 상태: vstate가 closed 이고 settings/vote도 open:false + closeAt 지남 (둘이 어긋나면 마감 아님)
    function mvFinal() {
      return exists(VS()) && get(VS()).data.phase == 'closed'
        && MV().get('open', true) == false && mvClosed();
    }
    // 공개 버튼이 행사일 이후에 눌렸고, 지금 epoch의 버튼일 것
    function mvRevealed() {
      return request.time >= mvEventDay()
        && exists(VR())
        && get(VR()).data.at >= mvEventDay()
        && get(VR()).data.get('epoch', -1) == mvEpoch();
    }
    function mvEntryOk(e) {
      return e is string && e.size() >= 1 && e.size() <= 64
        && get(/databases/$(db)/documents/entries/$(e)).data.get('on', true) == true;
    }
    // 유효 탑승권: 존재하고 active. test 탑승권은 allowTest일 때만
    function mvVoterOk(t) {
      let p = get(P(t)).data;
      return t.size() >= 20
        && p.status == 'active'
        && (p.get('test', false) != true || MV().get('allowTest', false) == true);
    }
    function mvWriteOk(t) {
      let d = request.resource.data;
      return d.keys().hasOnly(['e', 'at']) && d.keys().hasAll(['e', 'at'])
        && d.at == request.time
        && mvEntryOk(d.e)
        && mvOpen()
        && mvPhaseOpen()
        && mvVoterOk(t);
    }

    // 작품: 누구나 관람(로그인 없음). 출품자 정보·표 수는 넣지 않는다
    // 필드 화이트리스트: 공개 문서에 표 수 같은 필드가 실수로 실리지 않게
    match /entries/{e} {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['number', 'name', 'description', 'image', 'order', 'on'])
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 40
        && request.resource.data.get('description', '') is string && request.resource.data.get('description', '').size() <= 600
        && request.resource.data.get('image', '') is string && request.resource.data.get('image', '').size() <= 300
        && request.resource.data.get('number', 0) is int
        && request.resource.data.get('order', 0) is int
        && request.resource.data.get('on', true) is bool;
      allow delete: if isOwner();
    }

    // 표: 탑승권 토큰 1개 = 문서 1개 = 1표. 변경은 같은 문서 덮어쓰기(단일 문서 쓰기라 원자적)
    match /votes/{t} {
      allow get: if true;   // 토큰을 아는 사람(본인, 어느 기기든)만 자기 선택 확인
      allow list: if mvFinal()
        && (isOwner() || (isAdmin() && MV().get('staffTally', false) == true));
      allow create: if mvWriteOk(t);
      allow update: if mvWriteOk(t);
      allow delete: if false;
    }

    // 진행 상태: 시작(create) → 마감(open→closed) → [재개(closed→open, epoch+1) → 마감 …]. 삭제 불가.
    // 각 전이는 같은 묶음(batch)에서 settings/vote도 맞춰 써야 통과한다 (규칙은 getAfter로 확인).
    match /vstate/{id} {
      allow read: if true;
      allow create: if id == 'main' && isOwner()
        && request.resource.data.keys().hasOnly(['phase', 'epoch', 'at'])
        && request.resource.data.keys().hasAll(['phase', 'epoch', 'at'])
        && request.resource.data.phase == 'open'
        && request.resource.data.epoch == 1
        && request.resource.data.at == request.time
        && getAfter(SV()).data.get('open', false) == true
        && !existsAfter(VR())
        && !existsAfter(VPUB());
      allow update: if id == 'main' && isOwner()
        && request.resource.data.keys().hasOnly(['phase', 'epoch', 'at'])
        && request.resource.data.keys().hasAll(['phase', 'epoch', 'at'])
        && request.resource.data.at == request.time
        && (
          // 마감: epoch 그대로. settings/vote는 open:false, closeAt <= 지금 (수동 마감이면 누른 시각으로)
          (resource.data.phase == 'open' && request.resource.data.phase == 'closed'
            && request.resource.data.epoch == resource.data.epoch
            && getAfter(SV()).data.get('open', true) == false
            && getAfter(SV()).data.get('closeAt', null) is timestamp
            && getAfter(SV()).data.closeAt <= request.time)
          // 재개: epoch+1. 공개 버튼은 같은 묶음에서 지워져 있어야 하고, settings/vote는 open:true + 미래 closeAt
          || (resource.data.phase == 'closed' && request.resource.data.phase == 'open'
            && request.resource.data.epoch == resource.data.epoch + 1
            && !existsAfter(VR())
            && getAfter(SV()).data.get('open', false) == true
            && getAfter(SV()).data.get('closeAt', null) is timestamp
            && getAfter(SV()).data.closeAt > request.time)
        );
      allow delete: if false;
    }

    // 공개 버튼: 행사일 시작 이후, 최종 마감 상태에서, 지금 epoch의 public 결과가 있을 때 owner가 누른 순간만 기록.
    // 내용은 at(서버 시각)과 epoch뿐 (누른 사람 이메일 없음 = 공개 문서라서)
    match /vreveal/{id} {
      allow read: if true;
      allow create: if id == 'main' && isOwner()
        && request.time >= mvEventDay()
        && mvFinal()
        && request.resource.data.keys().hasOnly(['at', 'epoch'])
        && request.resource.data.keys().hasAll(['at', 'epoch'])
        && request.resource.data.at == request.time
        && request.resource.data.epoch == mvEpoch()
        && exists(VPUB())
        && get(VPUB()).data.get('epoch', -1) == mvEpoch();
      allow update: if false;
      allow delete: if isOwner();   // 공개 취소 (재개할 때는 반드시 같은 묶음에서 지워야 함)
    }

    // 결과: owner가 최종 마감 상태에서 지금 epoch로 작성. public은 최종 마감 + 행사일 이후 + 지금 epoch 공개 버튼 + 지금 epoch 결과일 때만 누구나 읽음
    match /vresults/{id} {
      allow read: if isOwner()
        || (id == 'public' && mvFinal() && mvRevealed()
            && resource.data.get('epoch', -1) == mvEpoch())
        || (id == 'staff' && isAdmin() && MV().get('staffTally', false) == true && mvFinal()
            && resource.data.get('epoch', -1) == mvEpoch());
      allow create, update: if isOwner() && id in ['public', 'staff'] && mvFinal()
        && request.resource.data.get('epoch', -1) == mvEpoch();
      allow delete: if isOwner();
    }
    // ================= 마스코트 투표 블록 끝 =================

    // ---------- SESSION ROSTER: isolated, no participant tokens ----------
    function rosterEmail() { return request.auth.token.email.lower(); }
    function rosterSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function ownRosterEmail(email) { return rosterSignedIn() && email == rosterEmail(); }
    function assignedRoster(sid) {
      return rosterSignedIn()
        && exists(/databases/$(db)/documents/sessionLeaderAccess/$(rosterEmail()))
        && sid in get(/databases/$(db)/documents/sessionLeaderAccess/$(rosterEmail())).data.sessions;
    }
    // Only trusted owners write snapshots. Member projection is validated by sync code.
    // Rules cannot iterate arbitrary arrays; never use this as a generic untrusted writer.
    match /sessionLeaderAccess/{email} {
      allow get: if isOwner() || ownRosterEmail(email);
      allow list: if isOwner();
      allow create, update: if isOwner()
        && email == email.lower() && email.matches('[^/ ]+@[^/ ]+\\.[^/ ]+')
        && request.resource.data.keys().hasOnly(['sessions'])
        && request.resource.data.keys().hasAll(['sessions'])
        && request.resource.data.sessions is list
        && request.resource.data.sessions.size() <= 30
        && request.resource.data.sessions.toSet().size() == request.resource.data.sessions.size()
        && (request.resource.data.sessions.size() <= 0 || (request.resource.data.sessions[0] is string && request.resource.data.sessions[0].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 1 || (request.resource.data.sessions[1] is string && request.resource.data.sessions[1].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 2 || (request.resource.data.sessions[2] is string && request.resource.data.sessions[2].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 3 || (request.resource.data.sessions[3] is string && request.resource.data.sessions[3].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 4 || (request.resource.data.sessions[4] is string && request.resource.data.sessions[4].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 5 || (request.resource.data.sessions[5] is string && request.resource.data.sessions[5].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 6 || (request.resource.data.sessions[6] is string && request.resource.data.sessions[6].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 7 || (request.resource.data.sessions[7] is string && request.resource.data.sessions[7].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 8 || (request.resource.data.sessions[8] is string && request.resource.data.sessions[8].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 9 || (request.resource.data.sessions[9] is string && request.resource.data.sessions[9].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 10 || (request.resource.data.sessions[10] is string && request.resource.data.sessions[10].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 11 || (request.resource.data.sessions[11] is string && request.resource.data.sessions[11].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 12 || (request.resource.data.sessions[12] is string && request.resource.data.sessions[12].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 13 || (request.resource.data.sessions[13] is string && request.resource.data.sessions[13].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 14 || (request.resource.data.sessions[14] is string && request.resource.data.sessions[14].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 15 || (request.resource.data.sessions[15] is string && request.resource.data.sessions[15].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 16 || (request.resource.data.sessions[16] is string && request.resource.data.sessions[16].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 17 || (request.resource.data.sessions[17] is string && request.resource.data.sessions[17].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 18 || (request.resource.data.sessions[18] is string && request.resource.data.sessions[18].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 19 || (request.resource.data.sessions[19] is string && request.resource.data.sessions[19].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 20 || (request.resource.data.sessions[20] is string && request.resource.data.sessions[20].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 21 || (request.resource.data.sessions[21] is string && request.resource.data.sessions[21].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 22 || (request.resource.data.sessions[22] is string && request.resource.data.sessions[22].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 23 || (request.resource.data.sessions[23] is string && request.resource.data.sessions[23].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 24 || (request.resource.data.sessions[24] is string && request.resource.data.sessions[24].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 25 || (request.resource.data.sessions[25] is string && request.resource.data.sessions[25].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 26 || (request.resource.data.sessions[26] is string && request.resource.data.sessions[26].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 27 || (request.resource.data.sessions[27] is string && request.resource.data.sessions[27].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 28 || (request.resource.data.sessions[28] is string && request.resource.data.sessions[28].matches('[A-Za-z0-9_-]{1,80}')))
        && (request.resource.data.sessions.size() <= 29 || (request.resource.data.sessions[29] is string && request.resource.data.sessions[29].matches('[A-Za-z0-9_-]{1,80}')));
      allow delete: if isOwner();
    }
    match /sessionRosters/{sid} {
      allow get: if isOwner() || assignedRoster(sid);
      allow list: if false;
      allow create, update: if isOwner()
        && sid.matches('[A-Za-z0-9_-]{1,80}') && exists(SE(sid))
        && request.resource.data.keys().hasOnly(['name', 'room', 'updatedAt', 'members'])
        && request.resource.data.keys().hasAll(['name', 'room', 'updatedAt', 'members'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.room is string && request.resource.data.room.size() <= 100
        && request.resource.data.updatedAt == request.time
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 1000;
      allow delete: if isOwner();
    }
    // ---------- SESSION ROSTER END ----------
  }
}
